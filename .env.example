# Copia este archivo como ".env" y completa los valores reales.
# Supabase → Project Settings → API (o "Data API" / "API Keys").
# Usa SOLO la clave pública (anon / publishable), nunca la service_role.
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-clave-publica-anon

# PIN de 4 dígitos para entrar al panel de administración.
EXPO_PUBLIC_ADMIN_PIN=1234
